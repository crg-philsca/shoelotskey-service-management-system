{
  "venvPath": ".",
  "venv": "venv",
  "extraPaths": [
    "backend",
    "backend/db",
    "backend/scripts",
    "backend/ml",
    "venv/Lib/site-packages"
  ],
  "exclude": [
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**",
    "**/venv/**",
    "**/brain/**",
    "**/tmp/**",
    "**/scratch/**",
    "c:/__pyrefly_virtual__/**"
  ],
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}

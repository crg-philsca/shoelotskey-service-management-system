      "intake_day_of_week",
      "intake_month"
    ],
    "feature_set_b_predictors_13": [
      "total_pairs",
      "distinct_service_types",
      "total_service_applications",
      "rush_indicator",
      "day_of_week_received",
      "month_received",
      "basic_cleaning_qty",
      "full_reglue_qty",
      "minor_reglue_qty",
      "full_restoration_qty",
      "minor_restoration_qty",
      "color_renewal_qty",
      "unyellowing_qty"
    ],
    "strictly_excluded_leakage_fields": [
      "max_service_duration",
      "dominant_duration",
      "rule_base_days",
      "expected_days",
      "expected_release_date",
      "simulated_ready_for_release_date",
      "ready_for_release_date",
      "raw_target_date",
      "sunday_rollover_days",
      "holiday_rollover_days",
      "total_rollover_days",
      "one_day_rush_eligible",
      "turnaround_days"
    ],
    "calendar_variation_disclosure": "Feature Set C contains intake-known operational and coarse calendar predictors but intentionally excludes exact calendar-date/closure-derived features. Consequently, limited target variation may remain for otherwise identical feature vectors when a calculated release date intersects an owner-confirmed special closure."
  },
  "calendar_and_closure_rules": {
    "closed_weekdays": [
      6
    ],
    "owner_confirmed_special_closures_2025_2026": [
      {

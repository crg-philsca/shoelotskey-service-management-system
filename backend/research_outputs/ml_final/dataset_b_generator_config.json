{
  "dataset_b_metadata": {
    "dataset_name": "Simulated Operational Dataset",
    "dataset_version": "1.0-frozen-phase2a8",
    "target_variable": "Received-to-Ready-for-Release Turnaround Days",
    "historical_source_reference": "Dataset A (Historical Order-to-Claim Turnaround, N=119 frozen)",
    "governing_business_rules": "Shoelotskey Service Management System Authorized Rules",
    "random_seed": 20261002,
    "sample_size_total": 10000,
    "partitions": {
      "train": 7000,
      "validation": 1500,
      "test": 1500
    },
    "target_conflation_guard": "DO NOT conflate Received-to-Ready-for-Release Turnaround Days with Dataset A historical Order-to-Claim Turnaround Days."
  },
  "template_derivation_audit": {
    "historical_configurations_untransformed": 37,
    "canonical_configurations_fr_corrected_only": 34,
    "canonical_configurations_fr_and_mret_corrected": 35,
    "derivation_explanation": "In Phase 2A.7, correcting the 7 FR-inflated records collapsed 37 raw configurations to 34 templates. In Phase 2A.8, grouping Minor Retouch (MRET) into minor_restoration_qty moves BC+MRET (1 row) into the existing BC+MRES template, but separates BC+MR+MRET (1 row, ORD-2026-01-02-006, 20-day tier) from pure BC+MR (2 rows, 10-day tier), creating exactly 35 collision-free canonical configurations summing to 119.",
    "total_historical_observations_represented": 119
  },
  "feature_specifications": {
    "feature_set_c_predictors_12": [
      "total_pairs",
      "basic_cleaning_qty",
      "full_reglue_qty",
      "minor_reglue_qty",
      "unyellowing_qty",
      "minor_restoration_qty",

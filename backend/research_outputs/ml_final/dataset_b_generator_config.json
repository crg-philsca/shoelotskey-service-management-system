      {
        "date": "2026-01-01",
        "description": "Owner-confirmed New Year's Day closure date"
      }
    ],
    "rollover_logic": "raw_target_date = intake_date + rule_base_days; release_date = NextOpenReleaseDate(raw_target_date); days = (release_date - intake_date).days",
    "sunday_in_progress_policy": "Sundays encountered while service is in progress count normally towards calendar turnaround."
  },
